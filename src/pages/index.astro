---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, withBase } from '../data/site';
import { NEWS } from '../data/news';
import { PUBLICATIONS } from '../data/publications';

const projects = (await getCollection('projects'))
  .filter((p) => p.data.selected)
  .sort((a, b) => a.data.importance - b.data.importance);

const selectedPubs = PUBLICATIONS.filter((p) => p.selected);

const projectLinks: Record<string, { label: string; href: string; external?: boolean }[]> = {
  turbulence: [
    { label: 'Project page', href: '/projects/turbulence/' },
    { label: 'Slides (PDF)', href: '/assets/slides/tbnn-les/research_slides.pdf', external: true },
  ],
  agriculture: [
    { label: 'Project page', href: '/projects/agriculture/' },
    { label: 'Slides (PDF)', href: '/assets/slides/tellmee/research_slides.pdf', external: true },
  ],
  avionics: [
    { label: 'Project page', href: '/projects/avionics/' },
  ],
};
---

<BaseLayout>
  <section class="hero">
    <div>
      <div class="name-line">
        <h1>{SITE.name}</h1>
        <span class="name-ja">{SITE.nameJa}</span>
      </div>
      <p class="hero-subtitle">{SITE.subtitle}</p>
      <div class="hero-bio">
        <p>
          I am an undergraduate researcher at <strong>Kyushu University</strong>, working with
          <strong>Prof. Kenichi Abe</strong> in the Department of Aeronautics and Astronautics. My
          research focuses on large-eddy simulation, data-driven turbulence modeling, and scientific
          machine learning for computational fluid dynamics.
        </p>
        <p>
          Currently, I study nonlinear subgrid-scale closures using
          <a href={withBase('/projects/turbulence/')}>tensor basis neural networks</a> coupled with
          OpenFOAM via LibTorch, examining their <em>a posteriori</em> behavior in turbulent
          channel flow at Re<sub>τ</sub> = 395.
        </p>
        <p>
          Previously, I built an
          <a href={withBase('/projects/agriculture/')}>agricultural AI assistant</a> (Tellmee)
          through the Fukuoka Mitou Program, interned as a software engineer at SERAKU, and worked on
          <a href={withBase('/projects/avionics/')}>hybrid rocket avionics</a> with PLANET-Q.
        </p>
      </div>

      <div class="link-bar" aria-label="Links">
        <a href={withBase(SITE.cvPdfPath)} target="_blank" rel="noopener noreferrer">CV (PDF)</a>
        {
          SITE.social.map((s) => (
            <>
              <span class="link-sep" aria-hidden="true">/</span>
              <a
                href={s.href}
                target={s.href.startsWith('http') ? '_blank' : undefined}
                rel={s.href.startsWith('http') ? 'noopener noreferrer' : undefined}
              >
                {s.label}
              </a>
            </>
          ))
        }
      </div>
    </div>

    <figure class="portrait">
      <img src={withBase('/assets/img/shuntaro-portrait.jpg')} alt="Shuntaro Nakanishi" />
      <figcaption>
        {SITE.location} ·{' '}
        <a href="https://mitou-fukuoka.org/works/solve-tellmee/" target="_blank" rel="noopener noreferrer">
          Photo
        </a>
      </figcaption>
    </figure>
  </section>

  <section>
    <h2>News</h2>
    <ul class="news-list">
      {
        NEWS.map((item) => (
          <li class="news-item">
            <span class="news-date">{item.displayDate}</span>
            <span class="news-text" set:html={item.html} />
          </li>
        ))
      }
    </ul>
  </section>

  <section>
    <div class="section-head">
      <h2>Research &amp; Projects</h2>
      <a class="section-more" href={withBase('/projects/')}>All projects →</a>
    </div>
    <div class="entry-list">
      {
        projects.map((project) => {
          const isPlot = project.id === 'turbulence';
          const links = projectLinks[project.id] ?? [
            { label: 'Project page', href: `/projects/${project.id}/` },
          ];
          return (
            <article class="entry-row">
              <a class="entry-thumb-link" href={withBase(`/projects/${project.id}/`)}>
                <img
                  class={`entry-thumb${isPlot ? ' contain' : ''}`}
                  src={withBase(project.data.img)}
                  alt={project.data.title}
                  loading="lazy"
                />
              </a>
              <div>
                <h3 class="entry-title">
                  <a href={withBase(`/projects/${project.id}/`)}>{project.data.title}</a>
                </h3>
                <p class="entry-meta">
                  {project.data.period} · {project.data.affiliation}
                </p>
                <p class="entry-desc">{project.data.description}</p>
                <div class="action-row">
                  {links.map((link) => (
                    <a
                      class="action-btn"
                      href={withBase(link.href)}
                      target={link.external ? '_blank' : undefined}
                      rel={link.external ? 'noopener noreferrer' : undefined}
                    >
                      {link.label}
                    </a>
                  ))}
                </div>
              </div>
            </article>
          );
        })
      }
    </div>
  </section>

  <section>
    <div class="section-head">
      <h2>Presentations</h2>
      <a class="section-more" href={withBase('/publications/')}>All presentations →</a>
    </div>
    <div class="entry-list">
      {
        selectedPubs.map((pub) => {
          const isPlot = pub.id === 'nakanishi2026tbnn';
          return (
            <article class="pub-row">
              <div class="pub-thumb-wrap">
                <img
                  class={`pub-thumb${isPlot ? ' contain' : ''}`}
                  src={withBase(pub.preview)}
                  alt={pub.title}
                  loading="lazy"
                />
              </div>
              <div>
                <h3 class="pub-title">{pub.title}</h3>
                <p class="pub-authors">
                  {pub.authors.map((a, idx) => (
                    <>
                      {a === 'Shuntaro Nakanishi' ? (
                        <span class="pub-author-self">{a}</span>
                      ) : (
                        a
                      )}
                      {idx < pub.authors.length - 1 ? ', ' : ''}
                    </>
                  ))}
                </p>
                <p class="pub-venue">
                  <em>{pub.venue}</em>, {pub.location}, {pub.date} ({pub.type}).
                </p>
                <div class="action-row">
                  {pub.links.map((link) => (
                    <a
                      class="action-btn"
                      href={link.isLocal ? withBase(link.href) : link.href}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {link.label}
                    </a>
                  ))}
                </div>
              </div>
            </article>
          );
        })
      }
    </div>
  </section>
</BaseLayout>
