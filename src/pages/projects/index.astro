---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../data/site';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.importance - b.data.importance
);
---

<BaseLayout
  title="Projects"
  description="Research and engineering projects in fluid dynamics, agricultural AI, and aerospace systems."
>
  <h1>Projects</h1>
  <p class="muted" style="margin: 0 0 2rem;">
    Research and engineering work in computational fluid dynamics, applied AI, and aerospace systems.
  </p>

  <div class="entry-list">
    {
      projects.map((project) => {
        const isPlot = project.id === 'turbulence';
        return (
          <article class="entry-row">
            <a class="entry-thumb-link" href={withBase(`/projects/${project.id}/`)}>
              {project.data.video ? (
                <video
                  class="entry-thumb"
                  autoplay
                  loop
                  muted
                  playsinline
                  poster={withBase(project.data.img)}
                  aria-label={project.data.title}
                >
                  <source src={withBase(project.data.video)} type="video/mp4" />
                </video>
              ) : (
                <img
                  class={`entry-thumb${isPlot ? ' contain' : ''}`}
                  src={withBase(project.data.img)}
                  alt={project.data.title}
                />
              )}
            </a>
            <div>
              <h2 class="entry-title">
                <a href={withBase(`/projects/${project.id}/`)}>{project.data.title}</a>
              </h2>
              <p class="entry-meta">
                {project.data.period} · {project.data.affiliation}
              </p>
              <p class="entry-desc">{project.data.description}</p>
            </div>
          </article>
        );
      })
    }
  </div>
</BaseLayout>
