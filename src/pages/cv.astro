---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, withBase } from '../data/site';
import cv from '../data/cv.json';
---

<BaseLayout title="CV" description="Curriculum Vitae of Shuntaro Nakanishi.">
  <h1 class="sr-only">Curriculum Vitae</h1>
  <div class="cv-header">
    <a class="action-btn action-btn-primary" href={withBase(SITE.cvPdfPath)} target="_blank" rel="noopener noreferrer">
      Download PDF →
    </a>
  </div>

  <section class="cv-section">
    <h2>Education</h2>
    {
      cv.education.map((edu) => (
        <div class="cv-entry">
          <div class="cv-entry-head">
            <span>{edu.institution}</span>
            <span class="cv-entry-loc">{edu.location}</span>
          </div>
          <div class="cv-entry-sub">
            <em>{edu.role}</em>
            <span class="cv-period">{edu.period}</span>
          </div>
        </div>
      ))
    }
  </section>

  <section class="cv-section">
    <h2>Research Interests</h2>
    <p style="margin: 0;">{cv.researchInterests}</p>
  </section>

  <section class="cv-section">
    <h2>Research Experience</h2>
    {
      cv.researchExperience.map((exp) => (
        <div class="cv-entry">
          <div class="cv-entry-head">
            <span>{exp.institution}</span>
            <span class="cv-entry-loc">{exp.location}</span>
          </div>
          <div class="cv-entry-sub">
            <em set:html={exp.role} />
            <span class="cv-period">{exp.period}</span>
          </div>
          <ul class="cv-bullets">
            {exp.bullets.map((b) => <li set:html={b} />)}
          </ul>
        </div>
      ))
    }
  </section>

  <section class="cv-section">
    <h2>Conference Presentations</h2>
    <ul class="cv-bullets" style="margin-top: 0;">
      {cv.presentations.map((p) => <li set:html={p} />)}
    </ul>
  </section>

  <section class="cv-section">
    <h2>Honors, Awards, and Grants</h2>
    {
      cv.honors.map((h) => (
        <div class="cv-entry">
          <div class="cv-entry-head">
            <span>{h.title}</span>
            <span class="cv-period">{h.period}</span>
          </div>
          <p style="margin: 0.3rem 0 0; font-size: 0.92rem;" set:html={h.detail} />
        </div>
      ))
    }
  </section>

  <section class="cv-section">
    <h2>Work Experience</h2>
    {
      cv.workExperience.map((w) => (
        <div class="cv-entry">
          <div class="cv-entry-head">
            <span>{w.institution}</span>
            <span class="cv-entry-loc">{w.location}</span>
          </div>
          <div class="cv-entry-sub">
            <em>{w.role}</em>
            <span class="cv-period">{w.period}</span>
          </div>
          <ul class="cv-bullets">
            {w.bullets.map((b) => <li set:html={b} />)}
          </ul>
        </div>
      ))
    }
  </section>

  <section class="cv-section">
    <h2>Leadership and Extracurricular Activities</h2>
    {
      cv.leadership.map((l) => (
        <div class="cv-entry">
          <div class="cv-entry-head">
            <span>{l.institution}</span>
            <span class="cv-entry-loc">{l.location}</span>
          </div>
          <div class="cv-entry-sub">
            <em>{l.role}</em>
            <span class="cv-period">{l.period}</span>
          </div>
          <ul class="cv-bullets">
            {l.bullets.map((b) => <li set:html={b} />)}
          </ul>
        </div>
      ))
    }
  </section>

  <section class="cv-section">
    <h2>Technical Skills</h2>
    <ul class="cv-bullets" style="margin-top: 0;">
      {
        cv.skills.map((s) => (
          <li>
            <strong>{s.category}:</strong> {s.items}
          </li>
        ))
      }
    </ul>
  </section>

  <section class="cv-section">
    <h2>Certifications</h2>
    {
      cv.certifications.map((c) => (
        <div class="cv-entry">
          <div class="cv-entry-head">
            <span>{c.title}</span>
            <span class="cv-period">{c.date}</span>
          </div>
          <div class="cv-entry-sub">
            <span>{c.issuer}</span>
          </div>
        </div>
      ))
    }
  </section>
</BaseLayout>
